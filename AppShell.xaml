<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ClassChat.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ClassChat"
    xmlns:pages="clr-namespace:ClassChat.Pages"
    Title="ClassChat">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Contracts"
        ContentTemplate="{DataTemplate pages:ContractsPage}"
        Route="ContractsPage" />

</Shell>
